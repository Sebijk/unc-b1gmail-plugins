+  /**
+   * Check the outer MIME headers written by openssl_pkcs7_encrypt().
+   * The value contains the plugin version, so comparing it to the bare plugin
+   * name (or comparing a fixed number of bytes) is not reliable.
+   */
+  private function _hasEncryptionMarker($fileName)
+  {
+    if (!is_file($fileName) || !is_readable($fileName) || ($fp = fopen($fileName, 'rb')) === false) {
+      return false;
+    }
+
+    $found = false;
+    while (($line = fgets($fp)) !== false && trim($line) !== '') {
+      if (preg_match('/^X-EncodedBy:\s*(CleverMailEncryption(?:\/[^\r\n]*)?)\s*$/i', rtrim($line, "\r\n"), $matches)) {
+        $found = true;
+        break;
+      }
+    }
+    fclose($fp);
+    return $found;
+  }
